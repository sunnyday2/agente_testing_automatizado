# ============================================================
# QA Automation Agent - Environment Variables
# ============================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# ============================================================

# --- Application ---
ENVIRONMENT=development
LOG_LEVEL=INFO
LOG_FORMAT=console
LLM_PROVIDER=gemini

# --- Ollama (Local LLM - optional, for offline usage) ---
OLLAMA_BASE_URL=http://qa-agent-ollama:11434
OLLAMA_MODEL=llama3.2
OLLAMA_EMBEDDING_MODEL=qwen2.5:7b
OLLAMA_TIMEOUT=120
OLLAMA_MAX_RETRIES=3

# --- Google Gemini (Recommended) ---
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-3.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_MAX_RETRIES=3

# --- ChromaDB ---
CHROMA_PERSIST_DIRECTORY=./data/chroma
CHROMA_COLLECTION_NAME=user_stories_v1
CHROMA_DISTANCE_FUNCTION=cosine
ANONYMIZED_TELEMETRY=false

# --- RAG Pipeline ---
RAG_CHUNK_SIZE=500
RAG_CHUNK_OVERLAP=50
RAG_TOP_K=3
RAG_SIMILARITY_THRESHOLD=0.7
RAG_STORIES_DIRECTORY=./data/stories

# --- Plane.so Integration ---
PLANE_BASE_URL=http://localhost:8080
PLANE_API_KEY=your-plane-api-key-here
PLANE_WORKSPACE_SLUG=your-workspace-slug
PLANE_PROJECT_ID=your-project-id
PLANE_WEBHOOK_SECRET=your-webhook-secret-here

# --- Site Crawler ---
CRAWLER_MAX_DEPTH=3
CRAWLER_MAX_PAGES=50
CRAWLER_TIMEOUT_PER_PAGE=10000
CRAWLER_SCREENSHOT_PAGES=true
CRAWLER_EXTRACT_ELEMENTS=true
CRAWLER_HEADLESS=true
CRAWLER_BROWSER=chromium

# --- Test Runner ---
TEST_BASE_URL=http://localhost:3000
TEST_HEADLESS=true
TEST_BROWSER=chromium
TEST_MAX_PARALLEL=3
TEST_TIMEOUT=30000
TEST_ALLURE_RESULTS_DIR=./data/allure-results
TEST_RETRY_ON_FAILURE=true
TEST_MAX_RETRIES=1

# --- FastAPI ---
API_HOST=0.0.0.0
API_PORT=8000
API_DEBUG=false
API_CORS_ORIGINS=http://localhost:3000,http://localhost:8080
API_WORKERS=1

# --- Database (SQLite) ---
DB_PATH=./data/qa_agent.db
DB_MIGRATIONS_DIR=./src/api/db/migrations

# --- Authentication (JWT) ---
JWT_SECRET=change-me-in-production-use-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRY_HOURS=24
JWT_COOKIE_NAME=access_token
JWT_COOKIE_SECURE=false
JWT_COOKIE_HTTPONLY=true
JWT_COOKIE_SAMESITE=lax

# --- Frontend ---
# In production, frontend is served from FastAPI (frontend/dist/)
# In development, frontend runs on its own Vite dev server
FRONTEND_URL=http://localhost:3000

# --- Git Auto-Commit (on successful test runs) ---
GIT_ENABLED=true
GIT_MODE=commit-only
GIT_REMOTE=origin
GIT_BRANCH=
GIT_STAGE_PATTERNS=tests/e2e/generated/**,data/allure-results/**
GIT_COMMIT_MESSAGE_TEMPLATE=test({feature}): PASSED - {timestamp} - {summary}
GIT_AUTHOR_NAME=QA Automation Agent
GIT_AUTHOR_EMAIL=qa-agent@automation.local
