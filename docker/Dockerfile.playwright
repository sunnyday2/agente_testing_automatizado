# Playwright test runner container
# Includes pre-installed browsers for headless E2E test execution
#
# Build: docker build -f docker/Dockerfile.playwright -t qa-agent-playwright .
# Run:   docker run --env-file .env qa-agent-playwright pytest -m smoke

FROM python:3.11-slim AS base

# System dependencies required by Playwright browsers
RUN apt-get update && apt-get install -y --no-install-recommends \
    git \
    curl \
    wget \
    libnss3 \
    libnspr4 \
    libatk1.0-0 \
    libatk-bridge2.0-0 \
    libcups2 \
    libdrm2 \
    libdbus-1-3 \
    libxkbcommon0 \
    libatspi2.0-0 \
    libxcomposite1 \
    libxdamage1 \
    libxfixes3 \
    libxrandr2 \
    libgbm1 \
    libpango-1.0-0 \
    libcairo2 \
    libasound2 \
    libxshmfence1 \
    fonts-liberation \
    fonts-noto-color-emoji \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Install Python dependencies (dev includes pytest, playwright, allure)
COPY requirements.txt requirements-dev.txt ./
RUN pip install --no-cache-dir -r requirements-dev.txt

# Install Playwright browsers (Chromium by default, add others as needed)
RUN python -m playwright install chromium
RUN python -m playwright install-deps chromium

# Copy application and test source
COPY src/ src/
COPY tests/ tests/
COPY pyproject.toml pytest.ini ./

# Create data directories for results
RUN mkdir -p data/stories data/chroma data/allure-results

# Copy test data
COPY data/stories/ data/stories/

# Non-root user
RUN useradd -m -r testrunner && chown -R testrunner:testrunner /app
USER testrunner

# Default: run smoke tests
CMD ["python", "-m", "pytest", "tests/e2e/", "-m", "smoke", "--alluredir=data/allure-results", "-v", "--tb=short"]
